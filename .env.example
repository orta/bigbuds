# Sealing key for the session cookie. `openssl rand -base64 32`
NUXT_SESSION_PASSWORD=

# Where the JSON member files live. On Railway this is a mounted volume's
# path; locally it defaults to ./.data if unset.
BIGBUDS_DATA_DIR=

# Encrypts members' stored gym passwords. `openssl rand -base64 32`
# Gladstone validates the password on every request, so it is stored (encrypted)
# and replayed rather than exchanged once for a token — this key protects it at
# rest. Losing this means every member has to sign in again. Rotating it has the
# same effect, so keep it somewhere durable.
BIGBUDS_ENCRYPTION_KEY=

# Optional: shared secret for POST /api/sync, if you drive the sync from an
# external scheduler rather than the built-in one.
BIGBUDS_SYNC_TOKEN=

# Optional: web push, for telling a member the club has taken them off a
# waiting list. Generate a pair with `yarn vapid`. Without them the app still
# notices the promotion and shows it the next time the member opens it — the
# notification is what is missing, not the feature.
#
# These identify this deployment to the browsers' push services and are not
# interchangeable between deployments. Changing them invalidates every
# subscription, and members have to turn notifications on again.
BIGBUDS_VAPID_PUBLIC_KEY=
BIGBUDS_VAPID_PRIVATE_KEY=
# A contact address, for a push service with a complaint about this app.
BIGBUDS_VAPID_SUBJECT=mailto:you@example.com

# Optional: which Gladstone activity "scope" the class timetable is drawn from.
# The gym's fitness classes live under "FITC" (the default); set this only if a
# club files its bookable classes under a different activity group.
KAL_SCOPE_IDS=

# Optional: a real membership for verifying against the live Gladstone API by
# hand (and exercised by the live checks during development).
KAL_EMAIL=
KAL_PASSWORD=
